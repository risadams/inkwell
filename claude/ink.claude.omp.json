{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": false,
  "palette": {
    "ink": "#1a1614",
    "paper": "#f4ecdd",
    "soft": "#ddd1bb",
    "rose": "#e24a8a",
    "rose-deep": "#8f0044",
    "teal": "#5ba3b8",
    "plum": "#b183b5",
    "ochre": "#d9a13f",
    "well": "#2a211c",
    "well-edge": "#3a2d26"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:ink",
          "background": "p:teal",
          "properties": {
            "style": "folder",
            "home_icon": "~"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:plum",
          "background_templates": [
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:ochre{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:ink",
          "background": "p:rose",
          "template": " {{ .Model.DisplayName }}{{ if .Effort }} · {{ .Effort.Level }}{{ end }} "
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:soft",
          "background": "p:well-edge",
          "foreground_templates": [
            "{{ if ge .FiveHourUsage 90 }}p:rose-deep{{ end }}",
            "{{ if ge .FiveHourUsage 70 }}p:ink{{ end }}"
          ],
          "background_templates": [
            "{{ if ge .FiveHourUsage 90 }}p:paper{{ end }}",
            "{{ if ge .FiveHourUsage 70 }}p:ochre{{ end }}"
          ],
          "template": "{{ if gt .FiveHourUsage 0 }} 5h {{ .FiveHourUsage.GaugeUsed }} {{ .FiveHourUsage }}% {{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:soft",
          "background": "p:well",
          "foreground_templates": [
            "{{ if ge .TokenUsagePercent 90 }}p:rose-deep{{ end }}",
            "{{ if ge .TokenUsagePercent 70 }}p:ink{{ end }}"
          ],
          "background_templates": [
            "{{ if ge .TokenUsagePercent 90 }}p:paper{{ end }}",
            "{{ if ge .TokenUsagePercent 70 }}p:ochre{{ end }}"
          ],
          "template": " {{ .TokenUsagePercent.GaugeUsed }} {{ if ge .TokenUsagePercent 90 }}context {{ end }}{{ .TokenUsagePercent }}% "
        }
      ]
    }
  ]
}
